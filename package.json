{
  "name": "toolhub-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter \"*\" --parallel dev",
    "build": "bun --filter \"@toolhub/client\" run build",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1"
  }
}
