{
  "name": "toolhub-monorepo",
  "version": "1.0.7",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter \"*\" --parallel dev",
    "build": "bash scripts/release.sh",
    "lint": "biome check .",
    "format": "biome format --write .",
    "version:patch": "bun run scripts/bump-version.ts patch",
    "version:minor": "bun run scripts/bump-version.ts minor",
    "version:major": "bun run scripts/bump-version.ts major",
    "pub": "bash scripts/publish.sh"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "bun-types": "^1.3.9",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1"
  }
}
